{
  "schemaVersion": 1,
  "id": "scp_byo",
  "version": "${version}",
  "name": "SCP: Build Your Own",
  "description": "A nice mod that allows you to build the SCP Fondation in minecraft, with all the functionalities that are expected",
  "authors": [
    "Natank25"
  ],

  "contact": {},
  "license": "All Rights Reserved",
  "icon": "mod_icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.natank25.scp_byo.fabric.Scp_byoFabric"
    ],
    "fabric-datagen": [
      "io.github.natank25.scp_byo.fabric.ModDatagen"
    ],
    "client": [
      "io.github.natank25.scp_byo.fabric.Scp_byoClientFabric"
    ]
  },

  "mixins": [
    "scp_byo-common.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.15.10",
    "minecraft": "~1.19.4",
    "java": ">=17",
    "architectury": ">=8.2.91",
    "fabric-api": "*",
    "cardinal-components-world": "~5.1.0",
    "cardinal-components-entity": "~5.1.0",
    "geckolib" : "4.2"
  },

  "custom": {
    "cardinal-components": [
      "scp_byo:multiblocks",
      "scp_byo:has_seen_scp"
    ]
  }
}
