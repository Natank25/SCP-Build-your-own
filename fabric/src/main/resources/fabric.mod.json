{
  "schemaVersion": 1,
  "id": "scp_byo",
  "version": "${version}",
  "name": "SCP: Build Your Own",
  "description": "A nice mod that allows you to build the SCP Foundation in minecraft, with all the functionalities that are expected",
  "authors": [
    "Natank25"
  ],

  "contact": {},
  "license": "All Rights Reserved",
  "icon": "mod_icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.natank25.scp_byo.fabric.Scp_byoFabric"
    ],
    "fabric-datagen": [
      "io.github.natank25.scp_byo.fabric.ModDatagen"
    ],
    "client": [
      "io.github.natank25.scp_byo.fabric.Scp_byoClientFabric"
    ]
  },

  "mixins": [
    "scp_byo-common.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=17",
    "architectury": ">=${architectury_api_version}",
    "fabric-api": "${fabric_api_version}",
    "geckolib" : "${geckolib_version}"
  }
}
